# ronda-demo.tipamedia.com: the read-only live demo, proxied to `ronda demo -public` on 127.0.0.1:9192.
# Copy to /etc/nginx/sites-available/ronda-demo, symlink into sites-enabled, then: nginx -t && systemctl reload nginx
#
# The demo is read-only inside the program already (every non-GET request answers 403, and /ping/ is refused).
# This file adds a second lock and some limits, because it is a public endpoint.

# One shared zone for the demo. Cloudflare passes the visitor's address in CF-Connecting-IP; the real_ip lines
# below make nginx see it (generate cloudflare-realip.conf with update-cloudflare-ips.sh).
limit_req_zone $binary_remote_addr zone=ronda_demo:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=ronda_demo_conn:10m;
# Opening the dashboard fetches about 30 small files at once (they are all served "no-store"), so the burst has to
# be well above that or a normal visit gets 503s. 20 requests a second sustained is still a lot for one person.

server {
    listen 80;
    listen [::]:80;
    server_name ronda-demo.tipamedia.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ronda-demo.tipamedia.com;

    # A Cloudflare Origin Certificate (or Let's Encrypt). With Cloudflare's SSL mode "Full (strict)" the origin
    # must present a certificate it trusts; see docs/hosting-landing-and-demo.md.
    ssl_certificate     /etc/ssl/ronda/origin.pem;
    ssl_certificate_key /etc/ssl/ronda/origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    include /etc/nginx/cloudflare-realip.conf;

    server_tokens off;
    client_max_body_size 1k;          # nothing may be uploaded to a read-only demo
    limit_req  zone=ronda_demo burst=100 nodelay;
    limit_conn ronda_demo_conn 40;

    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        # Second lock: only reading. (The program refuses everything else as well.)
        limit_except GET HEAD { deny all; }

        proxy_pass http://127.0.0.1:9192;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
        proxy_connect_timeout 5s;
    }

    # Push-monitor URLs are not part of a demo, and a GET there would change state in a normal install.
    location ^~ /ping/ { return 404; }
}
